[Unit]
Description=Keep Quartz MATE panel theming synchronized
After=graphical-session.target
PartOf=graphical-session.target
ConditionPathExists=%h/.themes/Quartz-System6/gtk-3.0/assets/panel-bar.xpm

[Service]
Type=simple
ExecStart=@LIBEXECDIR@/quartz-panel-theme --watch
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
