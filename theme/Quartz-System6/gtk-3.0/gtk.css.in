/* Quartz: compact System 7 geometry with native bitmap text. */
@define-color quartz_ink #000000;
@define-color quartz_paper @quartz_application;
@define-color quartz_application @QUARTZ_APPLICATION_BG@;
@define-color quartz_menubar @QUARTZ_MENUBAR_BG@;
@define-color quartz_titlebar @QUARTZ_TITLEBAR_BG@;
@define-color quartz_chrome @quartz_application;
@define-color quartz_inactive @quartz_application;
@define-color quartz_disabled @QUARTZ_APPLICATION_DISABLED_FG@;
@define-color quartz_disabled_bg @QUARTZ_APPLICATION_DISABLED_BG@;
@define-color quartz_pressed @QUARTZ_APPLICATION_SHADE@;
@define-color quartz_toggle_on @QUARTZ_APPLICATION_SHADE@;
@define-color quartz_suggested #ddf1d8;
@define-color quartz_suggested_pressed #cbdec7;
@define-color quartz_destructive #f4d6d6;
@define-color quartz_destructive_pressed #e0c5c5;
@define-color quartz_scroll_thumb @quartz_application;
@define-color quartz_tooltip #ffecb3;

/* GTK 3 applications still consume the historical public theme palette by
 * name. Keep the compatibility names explicit so application CSS cannot fall
 * back to colors from the distribution theme. */
@define-color theme_fg_color #000000;
@define-color theme_text_color #000000;
@define-color theme_bg_color @quartz_application;
@define-color theme_base_color @quartz_application;
@define-color theme_selected_bg_color #000000;
@define-color theme_selected_fg_color @quartz_application;
@define-color theme_unfocused_fg_color #000000;
@define-color theme_unfocused_text_color #000000;
@define-color theme_unfocused_bg_color @quartz_application;
@define-color theme_unfocused_base_color @quartz_application;
@define-color theme_unfocused_selected_bg_color #000000;
@define-color theme_unfocused_selected_fg_color @quartz_application;
@define-color theme_tooltip_bg_color @quartz_tooltip;
@define-color theme_tooltip_fg_color @quartz_ink;
@define-color insensitive_bg_color @quartz_application;
@define-color insensitive_fg_color @quartz_disabled;
@define-color insensitive_base_color @quartz_application;
@define-color unfocused_insensitive_color @quartz_disabled;
@define-color content_view_bg @quartz_application;
@define-color text_view_bg @quartz_application;
@define-color borders #000000;
@define-color unfocused_borders #000000;
@define-color link_color #000000;
@define-color visited_link_color #000000;
@define-color warning_color #000000;
@define-color error_color #000000;
@define-color success_color #000000;

* {
  background-image: none;
  text-shadow: none;
  box-shadow: none;
  -gtk-icon-shadow: none;
  border-radius: 0;
  transition: none;
  animation: none;
  outline-color: @quartz_ink;
  outline-style: dotted;
  outline-width: 1px;
  outline-offset: -3px;
  -GtkDialog-button-spacing: 8;
  -GtkDialog-action-area-border: 8;
  -GtkScrolledWindow-scrollbar-spacing: 0;
  -GtkScrollbar-has-backward-stepper: true;
  -GtkScrollbar-has-forward-stepper: true;
  -GtkScrollbar-has-secondary-backward-stepper: false;
  -GtkScrollbar-has-secondary-forward-stepper: false;
}

window,
dialog,
.background,
headerbar,
toolbar,
actionbar,
statusbar,
frame,
calendar,
notebook {
  color: @quartz_ink;
  background-color: @quartz_chrome;
}

/* GTK client-side decorations do not use Marco's server-side frame. Keep their
 * actual outer window node square and one-bit; the decoration node below owns
 * the same hard bottom-only shadow as Marco. */
window.csd,
window.dialog.csd,
dialog.csd,
window.background.csd {
  border: 1px solid @quartz_ink;
  border-radius: 0;
  box-shadow: none;
}

/* This is an opaque zero-blur extent. The asymmetric border guarantees the
 * same two-pixel bottom silhouette on the non-composited solid-CSD path,
 * where GTK clips pixels outside the window surface. */
.solid-csd decoration {
  margin: 0;
  border-color: #000000;
  border-style: solid;
  border-width: 1px 1px 2px 1px;
  border-radius: 0;
  padding: 0;
  box-shadow: 0 1px 0 0 #000000;
}

label,
title,
.title,
.subtitle,
.heading,
.dim-label,
strong,
b {
  font-style: normal;
  font-weight: 400;
}

*:disabled {
  color: @quartz_disabled;
  opacity: 1;
  -gtk-icon-effect: none;
}

/* Symbolic icons follow the foreground of the control or row that owns them.
 * Pinning every image to the window ink forces each state to rediscover every
 * possible internal GtkButton wrapper and is the source of black-on-black
 * icons in legacy image-property buttons. Fixed-color pixbufs ignore color. */
image,
image:backdrop {
  color: inherit;
  opacity: 1;
  -gtk-icon-effect: none;
  -gtk-icon-shadow: none;
}

image:disabled {
  opacity: 1;
  -gtk-icon-effect: none;
}

/* Raised buttons cast one hard pixel below their radius-matched body. Keeping
 * one pixel of bottom margin lets the active state exchange it for top margin:
 * the whole surface moves down without changing its layout request. */
button,
combobox button {
  color: @quartz_ink;
  background-color: @quartz_chrome;
  border: 1px solid @quartz_ink;
  min-height: 18px;
  min-width: 18px;
  padding: 1px 7px;
  margin-top: 0;
  margin-bottom: 1px;
  box-shadow: 0 1px 0 0 @quartz_ink;
}

/* Keyboard focus is an inset dotted contour, not a second solid button
 * frame. GTK derives its corner curve from the button's configured radius. */
button:focus,
combobox button:focus {
  outline-color: @quartz_ink;
  outline-style: dotted;
  outline-width: 1px;
  outline-offset: -3px;
}

button:hover,
combobox button:hover {
  color: @quartz_ink;
  background-color: @quartz_paper;
}

/* A latched toggle remains physically pressed: its application-derived shade
 * occupies the former shadow row until the value is cleared. */
button:checked,
combobox button:checked {
  color: @quartz_ink;
  background-color: @quartz_toggle_on;
  margin-top: 1px;
  margin-bottom: 0;
  box-shadow: none;
}

/* GtkToggleButton and radio-style button groups use the same palette shade on
 * hover, whether or not they are currently latched. */
button.toggle:hover,
button.radio:hover {
  background-color: @quartz_toggle_on;
}

/* Pointer-down uses the same lowered geometry as checked and disabled buttons. */
button:active,
combobox button:active {
  color: @quartz_ink;
  background-color: @quartz_pressed;
  margin-top: 1px;
  margin-bottom: 0;
  box-shadow: none;
}

/* Semantic actions use the same geometry as an ordinary button. Their pale
 * faces communicate intent without a heavier ring or different silhouette. */
button.suggested-action,
button.suggested-action:hover,
button.suggested-action:checked {
  color: @quartz_ink;
  background-color: @quartz_suggested;
  background-image: none;
  margin: 0 0 1px;
  box-shadow: 0 1px 0 0 @quartz_ink;
}

button.suggested-action:active {
  background-color: @quartz_suggested_pressed;
  margin: 1px 0 0;
  box-shadow: none;
}

button.destructive-action,
button.destructive-action:hover,
button.destructive-action:checked {
  color: @quartz_ink;
  background-color: @quartz_destructive;
  background-image: none;
  margin: 0 0 1px;
  box-shadow: 0 1px 0 0 @quartz_ink;
}

button.destructive-action:active {
  background-color: @quartz_destructive_pressed;
  margin: 1px 0 0;
  box-shadow: none;
}

button:disabled,
button.suggested-action:disabled,
button.destructive-action:disabled,
combobox button:disabled {
  color: @quartz_disabled;
  background-color: @quartz_disabled_bg;
  border-color: @quartz_disabled;
  margin-top: 1px;
  margin-bottom: 0;
  box-shadow: none;
}

combobox arrow {
  min-height: 12px;
  min-width: 12px;
  -gtk-icon-source: url("assets/arrow-down.xpm");
}

combobox button:active arrow,
combobox button:checked arrow {
  -gtk-icon-source: url("assets/arrow-down.xpm");
}

button.flat {
  border-color: transparent;
  background-color: transparent;
  margin-top: 0;
  margin-bottom: 1px;
  box-shadow: none;
}

/* Flat controls acknowledge hover with fill alone. Keep the transparent
 * border reservation so their contents never jump when the state changes. */
button.flat:hover {
  color: @quartz_ink;
  border-color: transparent;
  background-color: @quartz_toggle_on;
  margin-top: 0;
  margin-bottom: 1px;
  box-shadow: none;
}

/* GTK_RELIEF_NONE adds .flat after the normal checked-button rule. Restore
 * the same application-shaded state for flat toggles so their foreground and
 * surface remain legible and consistent. */
button.flat:active,
button.flat:checked {
  color: @quartz_ink;
  border-color: transparent;
  background-color: @quartz_pressed;
  margin-top: 0;
  margin-bottom: 1px;
  box-shadow: none;
}

/* Insensitive always wins over hover/pressed/checked. GTK can retain CHECKED
 * while a toggle is disabled, so relying on source order alone is unsafe. */
button:disabled:hover,
button:disabled:active,
button:disabled:checked,
combobox button:disabled:hover,
combobox button:disabled:active,
combobox button:disabled:checked {
  color: @quartz_disabled;
  background-color: @quartz_disabled_bg;
  border-color: @quartz_disabled;
  margin-top: 1px;
  margin-bottom: 0;
  box-shadow: none;
}

combobox button:disabled arrow,
combobox button:disabled:hover arrow,
combobox button:disabled:active arrow,
combobox button:disabled:checked arrow {
  -gtk-icon-source: url("assets/arrow-down-disabled.xpm");
}

button.flat:disabled:hover,
button.flat:disabled:active,
button.flat:disabled:checked {
  color: @quartz_disabled;
  background-color: transparent;
  border-color: transparent;
  margin-top: 0;
  margin-bottom: 1px;
  box-shadow: none;
}

/* Content views are part of the selected application surface. */
textview text,
treeview,
iconview,
.view,
viewport {
  color: @quartz_ink;
  background-color: @quartz_application;
}

/* Entry controls use the same paper/application face as the surrounding UI. */
entry,
spinbutton,
combobox button {
  color: @quartz_ink;
  background-color: @quartz_paper;
}

entry {
  border: 1px solid @quartz_ink;
  min-height: 18px;
  padding: 1px 4px;
}

entry:focus {
  outline-style: dotted;
  outline-offset: -3px;
}

entry:disabled,
spinbutton:disabled {
  color: @quartz_disabled;
  background-color: @quartz_chrome;
  border-color: @quartz_disabled;
}

entry selection,
textview text selection,
selection {
  color: @quartz_paper;
  background-color: @quartz_ink;
}

spinbutton {
  border: 1px solid @quartz_ink;
  padding: 0;
}

spinbutton entry {
  /* Let the rounded parent own the corner pixels instead of covering its
   * diagonal border with the square internal text surface. */
  background-color: transparent;
  border: 0;
  min-height: 18px;
  padding: 1px 4px;
}

spinbutton entry:disabled {
  background-color: transparent;
}

spinbutton button {
  min-height: 18px;
  min-width: 18px;
  padding: 0;
  border-width: 0 0 0 1px;
  margin: 0;
  box-shadow: none;
}

spinbutton button:active {
  color: @quartz_ink;
  background-color: @quartz_pressed;
  margin: 0;
  box-shadow: none;
}

/* Vertical spins are a joined stack: complete stepper frames and a text
 * surface with side borders, instead of horizontal-only left separators. */
spinbutton.vertical {
  border: 0;
  padding: 0;
  background-color: transparent;
}

spinbutton.vertical > button {
  border: 1px solid @quartz_ink;
  margin: 0;
}

spinbutton.vertical > entry {
  border-style: solid;
  border-color: @quartz_ink;
  border-width: 0 1px;
  border-radius: 0;
  background-color: @quartz_paper;
  padding: 1px 4px;
}

spinbutton.vertical > button:disabled,
spinbutton.vertical > entry:disabled {
  border-color: @quartz_disabled;
  background-color: @quartz_chrome;
}

/* Native 12px XPMs keep every indicator on the one-bit pixel grid. */
check,
radio {
  background-color: transparent;
  border: 0;
  margin: 0 4px 0 0;
  min-height: 12px;
  min-width: 12px;
  padding: 0;
}

check {
  -gtk-icon-source: url("../gtk-2.0/assets/check-off.xpm");
}

check:checked,
check:indeterminate {
  -gtk-icon-source: url("../gtk-2.0/assets/check-on.xpm");
}

radio {
  -gtk-icon-source: url("../gtk-2.0/assets/radio-off.xpm");
}

radio:checked {
  -gtk-icon-source: url("../gtk-2.0/assets/radio-on.xpm");
}

check:disabled {
  -gtk-icon-source: url("../gtk-2.0/assets/check-off-disabled.xpm");
}

check:checked:disabled,
check:indeterminate:disabled {
  -gtk-icon-source: url("../gtk-2.0/assets/check-on-disabled.xpm");
}

radio:disabled {
  -gtk-icon-source: url("../gtk-2.0/assets/radio-off-disabled.xpm");
}

radio:checked:disabled {
  -gtk-icon-source: url("../gtk-2.0/assets/radio-on-disabled.xpm");
}

row:selected check:not(:disabled),
flowboxchild:selected check:not(:disabled),
modelbutton:hover check:not(:disabled),
modelbutton:active check:not(:disabled),
modelbutton:selected check:not(:disabled),
modelbutton:checked check:not(:disabled),
menuitem:hover > check:not(:disabled),
menuitem:active > check:not(:disabled),
menuitem:selected > check:not(:disabled),
menuitem:checked > check:not(:disabled) {
  -gtk-icon-source: url("../gtk-2.0/assets/check-off-inverse.xpm");
}

row:selected check:checked:not(:disabled),
row:selected check:indeterminate:not(:disabled),
flowboxchild:selected check:checked:not(:disabled),
flowboxchild:selected check:indeterminate:not(:disabled),
modelbutton:hover check:checked:not(:disabled),
modelbutton:hover check:indeterminate:not(:disabled),
modelbutton:active check:checked:not(:disabled),
modelbutton:active check:indeterminate:not(:disabled),
modelbutton:selected check:checked:not(:disabled),
modelbutton:selected check:indeterminate:not(:disabled),
modelbutton:checked check:checked:not(:disabled),
modelbutton:checked check:indeterminate:not(:disabled),
menuitem:hover > check:checked:not(:disabled),
menuitem:hover > check:indeterminate:not(:disabled),
menuitem:active > check:checked:not(:disabled),
menuitem:active > check:indeterminate:not(:disabled),
menuitem:selected > check:checked:not(:disabled),
menuitem:selected > check:indeterminate:not(:disabled),
menuitem:checked > check:checked:not(:disabled),
menuitem:checked > check:indeterminate:not(:disabled) {
  -gtk-icon-source: url("../gtk-2.0/assets/check-on-inverse.xpm");
}

row:selected radio:not(:disabled),
flowboxchild:selected radio:not(:disabled),
modelbutton:hover radio:not(:disabled),
modelbutton:active radio:not(:disabled),
modelbutton:selected radio:not(:disabled),
modelbutton:checked radio:not(:disabled),
menuitem:hover > radio:not(:disabled),
menuitem:active > radio:not(:disabled),
menuitem:selected > radio:not(:disabled),
menuitem:checked > radio:not(:disabled) {
  -gtk-icon-source: url("../gtk-2.0/assets/radio-off-inverse.xpm");
}

row:selected radio:checked:not(:disabled),
flowboxchild:selected radio:checked:not(:disabled),
modelbutton:hover radio:checked:not(:disabled),
modelbutton:active radio:checked:not(:disabled),
modelbutton:selected radio:checked:not(:disabled),
modelbutton:checked radio:checked:not(:disabled),
menuitem:hover > radio:checked:not(:disabled),
menuitem:active > radio:checked:not(:disabled),
menuitem:selected > radio:checked:not(:disabled),
menuitem:checked > radio:checked:not(:disabled) {
  -gtk-icon-source: url("../gtk-2.0/assets/radio-on-inverse.xpm");
}

/* Toggle cell renderers carry selection on the indicator node itself rather
 * than on a row ancestor.  Give those cells the same true inverse bitmap. */
treeview.view check:selected:not(:disabled) {
  -gtk-icon-source: url("../gtk-2.0/assets/check-off-inverse.xpm");
}

treeview.view check:selected:checked:not(:disabled),
treeview.view check:selected:indeterminate:not(:disabled) {
  -gtk-icon-source: url("../gtk-2.0/assets/check-on-inverse.xpm");
}

treeview.view radio:selected:not(:disabled) {
  -gtk-icon-source: url("../gtk-2.0/assets/radio-off-inverse.xpm");
}

treeview.view radio:selected:checked:not(:disabled) {
  -gtk-icon-source: url("../gtk-2.0/assets/radio-on-inverse.xpm");
}

/* Native one-bit switch artwork: a single outline and paper moving thumb.
 * Nine-sliced track corners follow the shared radius without antialiasing. */
switch {
  color: transparent;
  background-color: transparent;
  background-image: none;
  border: 0 solid transparent;
  border-radius: 0;
  border-image-source: url("assets/@QUARTZ_SWITCH_ASSET_PREFIX@-track-off.xpm");
  border-image-slice: @QUARTZ_SWITCH_SLICE@ fill;
  border-image-width: @QUARTZ_SWITCH_SLICE@px;
  border-image-repeat: stretch;
  min-height: 16px;
  min-width: 32px;
  padding: 0;
  margin: 2px 0;
  box-shadow: none;
  transition: none;
}

switch:checked {
  color: transparent;
  background-image:
    linear-gradient(to right, transparent 50%, @quartz_paper 50%),
    url("assets/@QUARTZ_SWITCH_ASSET_PREFIX@-dither.xpm");
  background-size: 100% 100%, 4px 2px;
  background-repeat: no-repeat, repeat;
  border-image-source: url("assets/@QUARTZ_SWITCH_ASSET_PREFIX@-track-on.xpm");
}

switch slider {
  background-color: transparent;
  background-image: url("assets/@QUARTZ_SWITCH_ASSET_PREFIX@-thumb.xpm");
  background-repeat: no-repeat;
  background-position: center;
  background-size: 12px 12px;
  border: 0;
  border-radius: 0;
  min-height: 16px;
  min-width: 16px;
  box-shadow: none;
}

switch:disabled {
  color: transparent;
  border-image-source: url("assets/@QUARTZ_SWITCH_ASSET_PREFIX@-track-disabled-off.xpm");
}

switch:checked:disabled {
  color: transparent;
  background-image:
    linear-gradient(to right, transparent 50%, @quartz_paper 50%),
    url("assets/@QUARTZ_SWITCH_ASSET_PREFIX@-dither-disabled.xpm");
  background-size: 100% 100%, 4px 2px;
  background-repeat: no-repeat, repeat;
  border-image-source: url("assets/@QUARTZ_SWITCH_ASSET_PREFIX@-track-disabled-on.xpm");
}

switch:disabled slider {
  background-image: url("assets/@QUARTZ_SWITCH_ASSET_PREFIX@-thumb-disabled.xpm");
}

/* The track/handle position communicates the state; hide toolkit I/O glyphs. */
switch image {
  color: transparent;
  opacity: 0;
}

/* Macintosh value rails: the remaining range is dithered and the completed
 * range is an application-colored pixel-cornered box with a one-pixel
 * bottom-only shadow. The native scale slider remains present for input but
 * paints no puck. */
scale:disabled {
  opacity: 0.5;
}

scale trough {
  background-color: @quartz_paper;
  background-image: url("assets/scale-dither.xpm");
  background-repeat: repeat;
  border: 0;
  border-radius: @QUARTZ_BORDER_RADIUS@;
  box-shadow: none;
}

scale highlight,
scale fill {
  background-color: transparent;
  background-image:
    linear-gradient(@quartz_ink, @quartz_ink),
    linear-gradient(@quartz_ink, @quartz_ink),
    linear-gradient(@quartz_ink, @quartz_ink),
    linear-gradient(@quartz_ink, @quartz_ink),
    linear-gradient(@quartz_paper, @quartz_paper),
    linear-gradient(@quartz_ink, @quartz_ink),
    linear-gradient(@quartz_ink, @quartz_ink),
    linear-gradient(@quartz_ink, @quartz_ink);
  background-size:
    calc(100% - 2px) 1px,
    calc(100% - 2px) 1px,
    1px calc(100% - 3px),
    1px calc(100% - 3px),
    calc(100% - 2px) calc(100% - 3px),
    calc(100% - 2px) 1px,
    100% calc(100% - 3px),
    calc(100% - 2px) 1px;
  background-position:
    1px 0,
    1px calc(100% - 1px),
    0 1px,
    100% 1px,
    1px 1px,
    1px 1px,
    0 2px,
    1px 100%;
  background-repeat: no-repeat;
  border: 0;
  /* The gradients own the one-bit corner cut; a CSS radius would antialias it. */
  border-radius: 0;
  box-shadow: none;
}

scale.horizontal trough {
  min-height: 14px;
}

scale.vertical trough {
  min-width: 14px;
}

scale slider {
  background-color: transparent;
  background-image: none;
  border: 0;
  border-radius: @QUARTZ_BORDER_RADIUS@;
  box-shadow: none;
  min-height: 0;
  min-width: 0;
  margin: 0;
  opacity: 0;
  padding: 0;
}

scale value {
  color: @quartz_ink;
  margin-bottom: 3px;
}

progressbar {
  color: @quartz_ink;
}

progressbar trough {
  background-color: @quartz_paper;
  border: 1px solid @quartz_ink;
  border-radius: @QUARTZ_BORDER_RADIUS@;
  min-height: 2px;
  min-width: 2px;
  padding: 0;
}

progressbar progress {
  background-color: @quartz_ink;
  border: 0;
  border-radius: @QUARTZ_BORDER_RADIUS@;
  min-height: 2px;
  min-width: 2px;
  padding: 0;
}

/* Level bars use the same framed one-bit meter instead of Adwaita's colored
 * severity blocks. */
levelbar trough {
  background-color: @quartz_paper;
  border: 1px solid @quartz_ink;
  border-radius: @QUARTZ_BORDER_RADIUS@;
  min-height: 0;
  min-width: 0;
  padding: 1px;
}

levelbar block {
  border: 0;
  border-radius: @QUARTZ_BORDER_RADIUS@;
  min-height: 3px;
  min-width: 3px;
}

/* Match the native baseline thickness in either orientation. */
levelbar.horizontal trough {
  min-height: 5px;
}

levelbar.vertical trough {
  min-width: 5px;
}

levelbar block.filled,
levelbar block.high,
levelbar block.low,
levelbar block.full {
  background-color: @quartz_ink;
}

levelbar block.empty {
  background-color: @quartz_paper;
}

levelbar.horizontal.discrete trough > block {
  margin: 0 1px;
}

levelbar.vertical.discrete trough > block {
  margin: 1px 0;
}

progressbar.horizontal progress.pulse {
  min-width: 40px;
}

progressbar.vertical progress.pulse {
  min-height: 40px;
}

progressbar text {
  color: @quartz_ink;
  margin-bottom: 4px;
}

/* Discrete native-size frames keep every spoke aligned to the pixel grid.
 * GTK marks running spinners :checked; stopped indicators paint nothing. */
@keyframes quartz-spinner {
  0% { background-image: -gtk-recolor(url("assets/spinner-symbolic.svg")); }
  12.5% { background-image: -gtk-recolor(url("assets/spinner-1-symbolic.svg")); }
  25% { background-image: -gtk-recolor(url("assets/spinner-2-symbolic.svg")); }
  37.5% { background-image: -gtk-recolor(url("assets/spinner-3-symbolic.svg")); }
  50% { background-image: -gtk-recolor(url("assets/spinner-4-symbolic.svg")); }
  62.5% { background-image: -gtk-recolor(url("assets/spinner-5-symbolic.svg")); }
  75% { background-image: -gtk-recolor(url("assets/spinner-6-symbolic.svg")); }
  87.5% { background-image: -gtk-recolor(url("assets/spinner-7-symbolic.svg")); }
  100% { background-image: -gtk-recolor(url("assets/spinner-symbolic.svg")); }
}

spinner {
  color: inherit;
  min-width: 12px;
  min-height: 12px;
  background-image: none;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 12px 12px;
  -gtk-icon-source: none;
  animation: none;
}

spinner:checked {
  background-image: -gtk-recolor(url("assets/spinner-symbolic.svg"));
  animation: quartz-spinner 800ms steps(8, end) infinite;
}

spinner:disabled {
  color: @quartz_disabled;
  animation: none;
}

/* The window frame owns the menubar's upper separator. Reserve the first
 * pixel in the configured face color so its lower rule is not doubled by
 * another black line, while retaining the measured 25-pixel allocation. */
menubar {
  color: @quartz_ink;
  background-color: @quartz_menubar;
  font-family: "ChiKareGo2";
  font-size: 16px;
  font-style: normal;
  font-weight: 400;
  border-top: 1px solid @quartz_menubar;
  border-bottom: 1px solid @quartz_ink;
  min-height: 23px;
  padding: 0;
}

menubar > menuitem {
  min-height: 23px;
  min-width: 0;
  padding: 0 7px;
}

menu,
.menu,
.context-menu {
  color: @quartz_ink;
  /* GTK 3 paints the border-image slices but does not consistently paint its
   * optional center fill. Paint the live palette below the content box while
   * keeping the five-pixel frame area transparent for the one-bit corners. */
  background-color: @quartz_paper;
  background-clip: padding-box;
  background-image: none;
  font-family: "ChiKareGo2";
  font-size: 16px;
  font-style: normal;
  font-weight: 400;
  border-color: transparent;
  border-style: solid;
  border-width: @QUARTZ_BORDER_SLICE_PX@px @QUARTZ_BORDER_SLICE_PX@px @QUARTZ_BORDER_SHADOW_SLICE_PX@px @QUARTZ_BORDER_SLICE_PX@px;
  border-image-source: url("assets/@QUARTZ_GTK3_MENU_FRAME_ASSET@");
  border-image-slice: @QUARTZ_BORDER_SLICE_PX@ @QUARTZ_BORDER_SLICE_PX@ @QUARTZ_BORDER_SHADOW_SLICE_PX@ @QUARTZ_BORDER_SLICE_PX@ fill;
  border-image-width: @QUARTZ_BORDER_SLICE_PX@px @QUARTZ_BORDER_SLICE_PX@px @QUARTZ_BORDER_SHADOW_SLICE_PX@px @QUARTZ_BORDER_SLICE_PX@px;
  border-image-repeat: stretch;
  /* GTK 3 stretches the top and bottom border-image strips beneath their
   * corner slices. Clip that implementation detail with the same shared
   * radius used to generate the one-bit frame, or a square strip remains
   * visible through each transparent bitmap corner. */
  border-radius: @QUARTZ_BORDER_RADIUS@;
  box-shadow: none;
  padding: 0;
}

/* Menus and panel dropdowns can be hosted by a generic GtkWindow.popup. Keep
 * the window and decoration transparent around the clipped nine-slice child;
 * the frame asset owns the hard outline and bottom shadow while the shared
 * radius suppresses GTK's edge-strip overdraw. */
window.popup {
  background-color: transparent;
  border-radius: @QUARTZ_BORDER_RADIUS@;
}

window.popup decoration {
  margin: 0;
  border: 0;
  border-radius: @QUARTZ_BORDER_RADIUS@;
  padding: 0;
  box-shadow: none;
}

/* Menu-model popovers are not necessarily hosted by that popup-window path. */
popover.menu,
popover.background.menu {
  font-family: "ChiKareGo2";
  font-size: 16px;
  font-style: normal;
  font-weight: 400;
}

/* Popovers draw an arrow through their border. Clear the menu nine-slice and
 * padding-box clip inherited by .menu, which otherwise erase that arrow and
 * leave a gap in the outline. Ordinary popovers retain application typography. */
popover.background,
popover {
  color: @quartz_ink;
  background-color: @quartz_paper;
  background-clip: border-box;
  border-image: none;
  border: 1px solid #000000;
  border-radius: @QUARTZ_BORDER_RADIUS@;
  box-shadow: 0 1px 0 0 #000000;
  padding: 1px;
}

popover modelbutton {
  min-height: 20px;
  padding: 0 7px;
}

menuitem {
  color: @quartz_ink;
  min-height: 20px;
  min-width: 48px;
  padding: 0 7px;
}

menuitem:hover,
menuitem:active,
menuitem:selected,
menuitem:checked {
  color: @quartz_paper;
  background-color: @quartz_ink;
}

menuitem:disabled {
  color: @quartz_disabled;
  /* GtkMenuItem allocations reach underneath GtkMenu's border-image.  Keep
   * insensitive rows transparent so they cannot erase the frame beside the
   * row; the menu surface already owns the palette-colored face. */
  background-color: transparent;
  background-image: none;
}

menuitem separator {
  margin: 2px 0;
}

menuitem accelerator {
  color: inherit;
}

menuitem arrow:dir(ltr) {
  min-height: 12px;
  min-width: 12px;
  margin-left: 6px;
  -gtk-icon-source: url("assets/arrow-right.xpm");
}

menuitem arrow:dir(rtl) {
  min-height: 12px;
  min-width: 12px;
  margin-right: 6px;
  -gtk-icon-source: url("assets/arrow-left.xpm");
}

menuitem:hover > arrow:dir(ltr),
menuitem:active > arrow:dir(ltr),
menuitem:selected > arrow:dir(ltr),
menuitem:checked > arrow:dir(ltr) {
  -gtk-icon-source: url("assets/arrow-right-inverse.xpm");
}

menuitem:hover > arrow:dir(rtl),
menuitem:active > arrow:dir(rtl),
menuitem:selected > arrow:dir(rtl),
menuitem:checked > arrow:dir(rtl) {
  -gtk-icon-source: url("assets/arrow-left-inverse.xpm");
}

menuitem:disabled > arrow:dir(ltr),
menuitem:disabled:hover > arrow:dir(ltr),
menuitem:disabled:active > arrow:dir(ltr),
menuitem:disabled:checked > arrow:dir(ltr) {
  -gtk-icon-source: url("assets/arrow-right.xpm");
}

menuitem:disabled > arrow:dir(rtl),
menuitem:disabled:hover > arrow:dir(rtl),
menuitem:disabled:active > arrow:dir(rtl),
menuitem:disabled:checked > arrow:dir(rtl) {
  -gtk-icon-source: url("assets/arrow-left.xpm");
}

popover modelbutton:hover,
popover modelbutton:active,
popover modelbutton:selected,
popover modelbutton:checked {
  color: @quartz_paper;
  background-color: @quartz_ink;
}

popover modelbutton:disabled,
popover modelbutton:disabled:hover,
popover modelbutton:disabled:active,
popover modelbutton:disabled:selected,
popover modelbutton:disabled:checked {
  color: @quartz_disabled;
  background-color: transparent;
  background-image: none;
}

popover modelbutton:disabled arrow:dir(ltr),
popover modelbutton:disabled:hover arrow:dir(ltr),
popover modelbutton:disabled:active arrow:dir(ltr),
popover modelbutton:disabled:checked arrow:dir(ltr) {
  -gtk-icon-source: url("assets/arrow-right.xpm");
}

popover modelbutton:disabled arrow:dir(rtl),
popover modelbutton:disabled:hover arrow:dir(rtl),
popover modelbutton:disabled:active arrow:dir(rtl),
popover modelbutton:disabled:checked arrow:dir(rtl) {
  -gtk-icon-source: url("assets/arrow-left.xpm");
}

tooltip,
tooltip.background,
.tooltip {
  color: @quartz_ink;
  background-color: @quartz_tooltip;
  border: 1px solid @quartz_ink;
  padding: 3px 5px;
}

tooltip label,
.tooltip label {
  color: inherit;
}

/* The tooltip surface owns the sole outline; its popup decoration stays bare. */
tooltip decoration,
window.popup.tooltip decoration,
.tooltip decoration {
  margin: 0;
  padding: 0;
  border: 0;
  box-shadow: none;
}

/* Toolbars are compact; stock MATE icons remain selected. */
toolbar {
  padding: 1px;
  border-bottom: 1px solid @quartz_ink;
}

toolbar button {
  min-height: 20px;
  min-width: 20px;
  padding: 1px;
  margin: 0 0 1px;
}

headerbar {
  min-height: 15px;
  padding: 0 3px;
  border: 0;
  border-bottom: 1px solid @quartz_ink;
  background-color: @quartz_titlebar;
  background-image: repeating-linear-gradient(
    to bottom,
    @quartz_ink 0,
    @quartz_ink 1px,
    @quartz_titlebar 1px,
    @quartz_titlebar 2px
  );
}

headerbar:backdrop {
  background-color: @quartz_titlebar;
  background-image: none;
}

headerbar windowtitle,
headerbar .title,
headerbar .subtitle {
  background-color: @quartz_titlebar;
  padding: 0 4px;
}

/* Preserve the established Chicago-like window-title role while application
 * content continues to inherit Geneva from GtkSettings. */
headerbar windowtitle,
headerbar .title,
.titlebar .title {
  font-family: "ChiKareGo2";
  font-size: 16px;
  font-style: normal;
  font-weight: 400;
}

headerbar button {
  min-height: 14px;
  margin: 1px 1px 2px;
  padding: 0 6px;
}

headerbar button:active {
  margin: 2px 1px 1px;
}

headerbar button.image-button,
headerbar button.titlebutton {
  min-height: 12px;
  min-width: 12px;
  margin: 2px 1px 3px;
  padding: 0;
}

headerbar button.image-button:active,
headerbar button.titlebutton:active {
  margin: 3px 1px 2px;
}

headerbar button.image-button image,
headerbar button.titlebutton image {
  min-height: 12px;
  min-width: 12px;
}

actionbar {
  padding: 4px;
  border-top: 1px solid @quartz_ink;
}

statusbar {
  min-height: 22px;
  margin: 0;
  padding: 1px 6px;
  border: 0;
}

/* GtkStatusbar puts its text inside a legacy GtkFrame. Keep the status area
 * as one flat gray strip instead of drawing a second inset field around it. */
statusbar frame,
statusbar frame > border {
  margin: 0;
  padding: 0;
  background-color: transparent;
  background-image: none;
  border: 0;
}

statusbar box {
  margin: 0;
  padding: 0;
}

statusbar label {
  color: inherit;
  background-color: transparent;
}

/* Tabs are visibly connected to their active page. */
notebook > header {
  background-color: @quartz_chrome;
  padding: 0;
}

notebook > header.top {
  border-bottom: 1px solid @quartz_ink;
}

notebook > header.bottom {
  border-top: 1px solid @quartz_ink;
}

notebook > header.left {
  border-right: 1px solid @quartz_ink;
}

notebook > header.right {
  border-left: 1px solid @quartz_ink;
}

notebook > header > tabs > tab {
  color: @quartz_ink;
  background-color: @quartz_inactive;
  border: 1px solid @quartz_ink;
  min-height: 20px;
  min-width: 28px;
  padding: 1px 8px;
  /* Share the adjacent tab divider and the header's bottom rule. */
  margin: 0 -1px -1px 0;
}

/* GtkNotebook owns keyboard focus; paint that focus on its selected tab. */
notebook:focus > header > tabs > tab:checked {
  outline-color: @quartz_ink;
  outline-style: dotted;
  outline-width: 1px;
  outline-offset: -3px;
}

notebook > header.top > tabs > tab {
  border-radius: @QUARTZ_BORDER_RADIUS@ @QUARTZ_BORDER_RADIUS@ 0 0;
}

notebook > header.top > tabs > tab:checked {
  background-color: @quartz_application;
  border-bottom-color: @quartz_application;
}

notebook > header.bottom > tabs > tab {
  margin: -1px -1px 0 0;
  border-radius: 0 0 @QUARTZ_BORDER_RADIUS@ @QUARTZ_BORDER_RADIUS@;
}

notebook > header.bottom > tabs > tab:checked {
  background-color: @quartz_application;
  border-top-color: @quartz_application;
}

notebook > header.left > tabs > tab {
  margin: 0 -1px -1px 0;
  border-radius: @QUARTZ_BORDER_RADIUS@ 0 0 @QUARTZ_BORDER_RADIUS@;
}

notebook > header.left > tabs > tab:checked {
  background-color: @quartz_application;
  border-right-color: @quartz_application;
}

notebook > header.right > tabs > tab {
  margin: 0 0 -1px -1px;
  border-radius: 0 @QUARTZ_BORDER_RADIUS@ @QUARTZ_BORDER_RADIUS@ 0;
}

notebook > header.right > tabs > tab:checked {
  background-color: @quartz_application;
  border-left-color: @quartz_application;
}

/* Frame the page; the header supplies its tab-facing edge. */
notebook > stack:not(:only-child) {
  color: @quartz_ink;
  background-color: @quartz_application;
  border: 1px solid @quartz_ink;
  border-radius: @QUARTZ_BORDER_RADIUS@;
}

notebook > header.top + stack:not(:only-child) {
  border-top: 0;
  border-radius: 0 0 @QUARTZ_BORDER_RADIUS@ @QUARTZ_BORDER_RADIUS@;
}

notebook > header.bottom + stack:not(:only-child) {
  border-bottom: 0;
  border-radius: @QUARTZ_BORDER_RADIUS@ @QUARTZ_BORDER_RADIUS@ 0 0;
}

notebook > header.left + stack:not(:only-child) {
  border-left: 0;
  border-radius: 0 @QUARTZ_BORDER_RADIUS@ @QUARTZ_BORDER_RADIUS@ 0;
}

notebook > header.right + stack:not(:only-child) {
  border-right: 0;
  border-radius: @QUARTZ_BORDER_RADIUS@ 0 0 @QUARTZ_BORDER_RADIUS@;
}

/* Bottom/right headers follow the page in GTK's node order. Share the
 * existing page edge rather than adding a second separator beside it. */
notebook > stack + header.bottom {
  margin-top: -1px;
}

notebook > stack + header.right {
  margin-left: -1px;
}

/* Lists, tables, and selections. */
/* GTK adds .frame when a scrolled view requests a native shadow/border.
 * This encloses tables, icon views and text views without framing every
 * scrolling container or drawing a second border around its child. */
scrolledwindow.frame {
  border: 1px solid @quartz_ink;
  border-radius: 0;
}

row {
  color: @quartz_ink;
  min-height: 20px;
}

list {
  color: @quartz_ink;
  background-color: @quartz_application;
  border: 1px solid @quartz_ink;
}

/* A framed scroll container owns the enclosure. GtkListBox is adapted by
 * GtkViewport; also cover a direct child without stripping frames from
 * unrelated lists nested deeper in composite content. */
scrolledwindow.frame > list,
scrolledwindow.frame > viewport > list {
  border: 0;
}

row:selected,
flowboxchild:selected,
treeview:selected,
treeview.view:selected,
treeview.view.cell:selected,
iconview:selected,
iconview.cell:selected,
.view.cell:selected,
.view:selected {
  color: @quartz_paper;
  background-color: @quartz_ink;
}

row:selected:disabled,
flowboxchild:selected:disabled,
treeview:selected:disabled,
treeview.view:selected:disabled,
treeview.view.cell:selected:disabled,
iconview:selected:disabled,
iconview.cell:selected:disabled,
.view.cell:selected:disabled,
.view:selected:disabled {
  color: @quartz_disabled;
  background-color: @quartz_paper;
}

row:selected:disabled *,
flowboxchild:selected:disabled * {
  color: inherit;
}

/* GtkIconView/ExoIconView labels are cell renderers rather than descendant
 * label widgets. Pin both focused and backdrop cells to the same Macintosh
 * inversion so selected filenames always retain paper-on-ink contrast. */
treeview.view.cell:backdrop:selected,
iconview.cell:backdrop:selected,
.view.cell:backdrop:selected {
  color: @quartz_paper;
  background-color: @quartz_ink;
}

/* GtkCellRendererProgress paints temporary classes on the tree-view node,
 * not the progressbar/trough/progress nodes used by GtkProgressBar. Its
 * padding is also the paint inset, so reserve the outline explicitly. */
treeview.view.trough {
  color: @quartz_ink;
  background-color: @quartz_paper;
  border: 1px solid @quartz_ink;
  border-radius: 0;
  padding: 1px;
}

treeview.view.progressbar {
  color: @quartz_paper;
  background-color: @quartz_ink;
  border: 0;
  border-radius: 0;
}

treeview.view.trough:selected,
treeview.view.trough:selected:backdrop {
  color: @quartz_paper;
  background-color: @quartz_ink;
  border-color: @quartz_paper;
}

treeview.view.progressbar:selected,
treeview.view.progressbar:selected:backdrop {
  color: @quartz_ink;
  background-color: @quartz_paper;
}

treeview.view.trough:disabled,
treeview.view.trough:disabled:selected,
treeview.view.trough:disabled:selected:backdrop {
  color: @quartz_disabled;
  background-color: @quartz_paper;
  border-color: @quartz_disabled;
}

treeview.view.progressbar:disabled,
treeview.view.progressbar:disabled:selected,
treeview.view.progressbar:disabled:selected:backdrop {
  color: @quartz_paper;
  background-color: @quartz_disabled;
}

treeview.view header button {
  color: @quartz_ink;
  background-color: @quartz_chrome;
  border-width: 0 1px 1px 0;
  min-height: 18px;
  padding: 0 5px;
  margin: 0;
  box-shadow: none;
}

treeview.view header button:active {
  margin: 0;
}

treeview.view header button:last-child {
  border-right-width: 0;
}

treeview.view header button:hover {
  color: @quartz_ink;
  background-color: @quartz_paper;
}

treeview.view separator {
  min-height: 1px;
  color: @quartz_ink;
}

rubberband,
.rubberband,
treeview.view rubberband,
iconview rubberband {
  border: 1px solid @quartz_ink;
  background-color: transparent;
  background-image: none;
}

/* Dithered classic scrollbars: the shared one-bit pattern fills the trough,
 * while the thumb and directional steppers retain their unboxed treatment. */
scrollbar {
  color: @quartz_ink;
  background-color: @quartz_paper;
  border: 0;
  box-shadow: none;
  opacity: 1;
}

scrollbar.vertical {
  min-width: 16px;
}

scrollbar.horizontal {
  min-height: 16px;
}

scrollbar trough {
  background-color: @quartz_paper;
  background-image: url("assets/scrollbar-dither.xpm");
  background-clip: content-box;
  background-repeat: repeat;
  border: 0;
  box-shadow: none;
}

scrollbar.vertical trough {
  padding: 0 4px;
}

scrollbar.horizontal trough {
  padding: 4px 0;
}

scrollbar:disabled trough {
  background-image: url("assets/scrollbar-dither-disabled.xpm");
}

scrollbar slider {
  background-color: @quartz_paper;
  /* Draw the application-colored body and its downward black shadow as separate
   * hard masks. The shadow repeats the body's one-pixel corner cut instead of
   * ending in the square tab produced by a native box-shadow. */
  background-image:
    linear-gradient(@quartz_ink, @quartz_ink),
    linear-gradient(@quartz_ink, @quartz_ink),
    linear-gradient(@quartz_ink, @quartz_ink),
    linear-gradient(@quartz_ink, @quartz_ink),
    linear-gradient(@quartz_scroll_thumb, @quartz_scroll_thumb),
    linear-gradient(@quartz_ink, @quartz_ink),
    linear-gradient(@quartz_ink, @quartz_ink),
    linear-gradient(@quartz_ink, @quartz_ink);
  background-size:
    calc(100% - 2px) 1px,
    calc(100% - 2px) 1px,
    1px calc(100% - 3px),
    1px calc(100% - 3px),
    calc(100% - 2px) calc(100% - 3px),
    calc(100% - 2px) 1px,
    100% calc(100% - 3px),
    calc(100% - 2px) 1px;
  background-position:
    1px 0,
    1px calc(100% - 1px),
    0 1px,
    100% 1px,
    1px 1px,
    1px 1px,
    0 2px,
    1px 100%;
  background-repeat: no-repeat;
  border: 0;
  /* The gradients own the one-bit corner cut; a CSS radius would antialias it. */
  border-radius: 0;
  box-shadow: none;
  min-height: 12px;
  min-width: 12px;
  margin: 0;
}

scrollbar.vertical slider {
  min-height: 24px;
  margin: 0 -2px;
}

scrollbar.horizontal slider {
  min-width: 24px;
  margin: -2px 0;
}

scrollbar button {
  color: @quartz_ink;
  background-color: @quartz_paper;
  border: 0;
  box-shadow: none;
  min-height: 12px;
  min-width: 12px;
  padding: 0;
  margin: 0;
}

scrollbar button:active {
  color: @quartz_ink;
  background-color: @quartz_pressed;
  margin: 0;
  box-shadow: none;
}

scrollbar button:disabled,
scrollbar button:disabled:hover,
scrollbar button:disabled:active,
scrollbar button:disabled:checked {
  color: @quartz_disabled;
  background-color: @quartz_paper;
  border: 0;
  margin: 0;
  box-shadow: none;
}

scrollbar.vertical button.up {
  -gtk-icon-source: url("assets/arrow-up.xpm");
}

scrollbar.vertical button.down {
  -gtk-icon-source: url("assets/arrow-down.xpm");
}

/* GTK 3 calls horizontal backward/forward steppers "up" and "down" in its
 * CSS node tree. Keep the directional aliases for custom scrollbar widgets. */
scrollbar.horizontal button.up,
scrollbar.horizontal button.left {
  -gtk-icon-source: url("assets/arrow-left.xpm");
}

scrollbar.horizontal button.down,
scrollbar.horizontal button.right {
  -gtk-icon-source: url("assets/arrow-right.xpm");
}

scrollbar.vertical button.up:active {
  -gtk-icon-source: url("assets/arrow-up.xpm");
}

scrollbar.vertical button.down:active {
  -gtk-icon-source: url("assets/arrow-down.xpm");
}

scrollbar.horizontal button.up:active,
scrollbar.horizontal button.left:active {
  -gtk-icon-source: url("assets/arrow-left.xpm");
}

scrollbar.horizontal button.down:active,
scrollbar.horizontal button.right:active {
  -gtk-icon-source: url("assets/arrow-right.xpm");
}

scrollbar.vertical button.up:disabled {
  -gtk-icon-source: url("assets/arrow-up-disabled.xpm");
}

scrollbar.vertical button.down:disabled {
  -gtk-icon-source: url("assets/arrow-down-disabled.xpm");
}

scrollbar.horizontal button.up:disabled,
scrollbar.horizontal button.left:disabled {
  -gtk-icon-source: url("assets/arrow-left-disabled.xpm");
}

scrollbar.horizontal button.down:disabled,
scrollbar.horizontal button.right:disabled {
  -gtk-icon-source: url("assets/arrow-right-disabled.xpm");
}

scrollbar.overlay-indicator,
scrollbar.overlay-indicator:not(.dragging):not(.hovering) {
  opacity: 1;
  background-color: @quartz_paper;
  border: 0;
  box-shadow: none;
}

scrollbar.overlay-indicator slider,
scrollbar.overlay-indicator:not(.dragging):not(.hovering) slider {
  opacity: 1;
}

/* Generated one-bit corner pixels keep the shared curve free of GTK's gray
 * antialiasing pixels. Hard one-pixel gradient stops continue that cadence
 * along every straight edge, including the labelled frame-gap path. */
frame > border {
  border: 1px solid transparent;
  border-image-source: none;
  border-radius: 0;
  background-image:
@QUARTZ_FRAME_DOT_BACKGROUND_IMAGES@
    repeating-linear-gradient(to right,
      @quartz_ink 0, @quartz_ink 1px, transparent 1px, transparent 2px),
    repeating-linear-gradient(to right,
      @quartz_ink 0, @quartz_ink 1px, transparent 1px, transparent 2px),
    repeating-linear-gradient(to bottom,
      @quartz_ink 0, @quartz_ink 1px, transparent 1px, transparent 2px),
    repeating-linear-gradient(to bottom,
      @quartz_ink 0, @quartz_ink 1px, transparent 1px, transparent 2px);
  background-size:
@QUARTZ_FRAME_DOT_BACKGROUND_SIZES@
    calc(100% - @QUARTZ_FRAME_EDGE_INSET@) 1px,
    calc(100% - @QUARTZ_FRAME_EDGE_INSET@) 1px,
    1px calc(100% - @QUARTZ_FRAME_EDGE_INSET@),
    1px calc(100% - @QUARTZ_FRAME_EDGE_INSET@);
  background-position:
@QUARTZ_FRAME_DOT_BACKGROUND_POSITIONS@
    center top, center bottom, left center, right center;
  background-repeat: no-repeat;
  background-origin: border-box;
  background-clip: border-box;
}

frame > label {
  background-color: @quartz_chrome;
  padding-left: 3px;
  padding-right: 3px;
}

separator {
  color: @quartz_ink;
  background-color: @quartz_ink;
  min-height: 1px;
  min-width: 1px;
}

paned > separator {
  color: @quartz_ink;
  background-color: @quartz_ink;
  background-image: none;
  -gtk-icon-source: none;
  border: 0;
  margin: 0;
  padding: 0;
  min-width: 1px;
  min-height: 1px;
}

paned.vertical > separator {
  min-width: 1px;
  min-height: 1px;
}

expander arrow,
treeview.view.expander {
  min-height: 12px;
  min-width: 12px;
  -gtk-icon-source: url("assets/arrow-right.xpm");
}

expander arrow:dir(rtl),
treeview.view.expander:dir(rtl) {
  -gtk-icon-source: url("assets/arrow-left.xpm");
}

expander arrow:checked,
treeview.view.expander:checked {
  -gtk-icon-source: url("assets/arrow-down.xpm");
}

row:selected expander arrow:not(:disabled),
flowboxchild:selected expander arrow:not(:disabled),
treeview.view.expander:selected:not(:disabled) {
  -gtk-icon-source: url("assets/arrow-right-inverse.xpm");
}

row:selected expander arrow:dir(rtl):not(:disabled),
flowboxchild:selected expander arrow:dir(rtl):not(:disabled),
treeview.view.expander:selected:dir(rtl):not(:disabled) {
  -gtk-icon-source: url("assets/arrow-left-inverse.xpm");
}

row:selected expander arrow:checked:not(:disabled),
flowboxchild:selected expander arrow:checked:not(:disabled),
treeview.view.expander:selected:checked:not(:disabled) {
  -gtk-icon-source: url("assets/arrow-down-inverse.xpm");
}

calendar {
  border: 1px solid @quartz_ink;
}

calendar:selected {
  color: @quartz_paper;
  background-color: @quartz_ink;
}

infobar {
  color: @quartz_ink;
  background-color: @quartz_chrome;
  border: 1px solid @quartz_ink;
}

dialog buttonbox,
dialog .dialog-action-area {
  padding: 8px;
  border-top: 1px solid @quartz_ink;
}

buttonbox > button,
dialog .dialog-action-area button {
  margin: 2px 4px 3px;
  min-width: 72px;
}

buttonbox > button:active,
dialog .dialog-action-area button:active {
  margin: 3px 4px 2px;
}

decoration {
  margin: 0;
  border: 0;
  border-radius: 0;
  /* GTK reserves transparent CSD extents outside the client. The first hard
   * spread paints the window outline there; the shifted spread adds only the
   * second bottom row, matching Marco's one-pixel shadow. */
  box-shadow: 0 0 0 1px #000000, 0 1px 0 1px #000000;
}

window.csd,
window.dialog.csd,
dialog.csd,
window.background.csd,
window.background.solid-csd {
  border-color: @quartz_ink;
  border-style: solid;
  border-width: 1px 1px 2px 1px;
}

/* Corner geometry follows GTK's own shape mask: a corner that is rounded in
 * base GTK uses the shared configured radius, while base-square corners stay
 * at zero. Window surfaces, decorations, and title strips are deliberately
 * absent from the rounded set and remain square above. */
.view:selected:focus,
iconview:selected:focus,
.view:selected,
iconview:selected,
.view text:selected:focus,
iconview text:selected:focus,
textview text:selected:focus,
.view text:selected,
iconview text:selected,
textview text:selected,
spinbutton:not(.vertical),
entry,
button,
button.titlebutton,
button.osd,
button.circular,
modelbutton.flat,
.menuitem.button.flat,
toolbar.osd,
.csd menu,
.csd .menu,
.csd .context-menu,
.csd popover.background,
popover.background,
scrollbar.overlay-indicator:not(.dragging):not(.hovering) button,
.view.content-view.check:not(list),
iconview.content-view.check:not(list),
.content-view:not(list) check,
check,
treeview.view radio:selected:focus,
treeview.view radio:selected,
radio,
progressbar trough,
progressbar progress,
scale trough,
scale slider,
scale.fine-tune trough,
levelbar trough,
levelbar block,
calendar:selected,
button.sidebar-button,
tooltip,
.tooltip,
colorswatch#editor-color-sample,
colorswatch#editor-color-sample overlay,
colorchooser .popover.osd,
.osd .scale-popup button.flat,
.scale-popup button:hover,
.keycap,
popover.emoji-picker .emoji :hover {
  border-radius: @QUARTZ_BORDER_RADIUS@;
}

/* Base GTK keeps these specialized descendants square even though their
 * parent widget family is rounded. */
.content-view .tile,
spinbutton.flat:not(.vertical),
entry.flat:focus,
entry.flat:backdrop,
entry.flat:disabled,
entry.flat,
spinbutton:not(.vertical) progress,
entry progress,
treeview entry.flat,
treeview entry,
button.color colorswatch:only-child,
button.color colorswatch:only-child overlay,
.osd spinbutton:not(.vertical) entry,
spinbutton:not(.vertical) entry,
spinbutton:not(.vertical) button,
.osd spinbutton:not(.vertical) button,
spinbutton.vertical entry,
treeview spinbutton:not(.vertical),
toolbar.osd.left,
toolbar.osd.right,
toolbar.osd.top,
toolbar.osd.bottom,
treeview.view:selected:focus,
treeview.view:selected,
treeview.view button.dnd,
treeview.view header.button.dnd,
treeview.view header button,
menu > arrow,
.menu > arrow,
.context-menu > arrow,
notebook > header > tabs > arrow,
scrollbar button,
scale.horizontal.marks-before:not(.marks-after) slider,
scale.horizontal.marks-after:not(.marks-before) slider,
scale.vertical.marks-before:not(.marks-after) slider,
scale.vertical.marks-after:not(.marks-before) slider,
progressbar.osd trough,
progressbar.osd progress,
levelbar.horizontal.discrete trough > block,
levelbar.vertical.discrete trough > block,
messagedialog.csd .dialog-action-area button,
window.dialog.message.csd .dialog-action-area button,
button.emoji-section {
  border-radius: 0;
}

/* Joined controls retain one-pixel square internal seams and round only the
 * outer corners that were nonzero in the base theme. GtkButtonBox receives
 * separate button margins above, even when GTK marks its layout .linked,
 * so its spaced buttons must retain their complete outline and corners. */
.linked:not(.vertical) > combobox > box > button.combo,
filechooser .path-bar.linked > button,
.linked:not(.vertical) > spinbutton:not(.vertical),
.linked:not(.vertical) > entry,
.inline-toolbar button,
.linked:not(.vertical):not(buttonbox) > button,
toolbar.inline-toolbar toolbutton > button.flat {
  border-right-style: none;
  border-radius: 0;
}

.linked.vertical > combobox > box > button.combo,
.linked.vertical > spinbutton:not(.vertical),
.linked.vertical > entry,
.linked.vertical:not(buttonbox) > button {
  border-style: solid solid none solid;
  border-radius: 0;
}

.linked:not(.vertical) > combobox:first-child > box > button.combo,
combobox.linked button:nth-child(2):dir(rtl),
filechooser .path-bar.linked > button:dir(rtl):last-child,
filechooser .path-bar.linked > button:dir(ltr):first-child,
.linked:not(.vertical) > spinbutton:first-child:not(.vertical),
.linked:not(.vertical) > entry:first-child,
.inline-toolbar button:first-child,
.linked:not(.vertical):not(buttonbox) > button:first-child,
toolbar.inline-toolbar toolbutton:first-child > button.flat {
  border-top-left-radius: @QUARTZ_BORDER_RADIUS@;
  border-bottom-left-radius: @QUARTZ_BORDER_RADIUS@;
}

.linked:not(.vertical) > combobox:last-child > box > button.combo,
combobox.linked button:nth-child(2):dir(ltr),
filechooser .path-bar.linked > button:dir(rtl):first-child,
filechooser .path-bar.linked > button:dir(ltr):last-child,
.linked:not(.vertical) > spinbutton:last-child:not(.vertical),
.linked:not(.vertical) > entry:last-child,
.inline-toolbar button:last-child,
.linked:not(.vertical):not(buttonbox) > button:last-child,
toolbar.inline-toolbar toolbutton:last-child > button.flat {
  border-right-style: solid;
  border-top-right-radius: @QUARTZ_BORDER_RADIUS@;
  border-bottom-right-radius: @QUARTZ_BORDER_RADIUS@;
}

.linked:not(.vertical) > combobox:only-child > box > button.combo,
filechooser .path-bar.linked > button:only-child,
.linked:not(.vertical) > spinbutton:only-child:not(.vertical),
.linked:not(.vertical) > entry:only-child,
.inline-toolbar button:only-child,
.linked:not(.vertical):not(buttonbox) > button:only-child,
toolbar.inline-toolbar toolbutton:only-child > button.flat,
.linked.vertical > combobox:only-child > box > button.combo,
.linked.vertical > spinbutton:only-child:not(.vertical),
.linked.vertical > entry:only-child,
.linked.vertical:not(buttonbox) > button:only-child {
  border-style: solid;
  border-radius: @QUARTZ_BORDER_RADIUS@;
}

.linked.vertical > combobox:first-child > box > button.combo,
.linked.vertical > spinbutton:first-child:not(.vertical),
.linked.vertical > entry:first-child,
.linked.vertical:not(buttonbox) > button:first-child {
  border-top-left-radius: @QUARTZ_BORDER_RADIUS@;
  border-top-right-radius: @QUARTZ_BORDER_RADIUS@;
}

.linked.vertical > combobox:last-child > box > button.combo,
.linked.vertical > spinbutton:last-child:not(.vertical),
.linked.vertical > entry:last-child,
.linked.vertical:not(buttonbox) > button:last-child {
  border-bottom-style: solid;
  border-bottom-left-radius: @QUARTZ_BORDER_RADIUS@;
  border-bottom-right-radius: @QUARTZ_BORDER_RADIUS@;
}

spinbutton:not(.vertical) button:dir(ltr):last-child,
.osd spinbutton:not(.vertical) button:dir(ltr):last-child {
  border-radius: 0 @QUARTZ_BORDER_RADIUS@ @QUARTZ_BORDER_RADIUS@ 0;
}

spinbutton:not(.vertical) button:dir(rtl):first-child,
.osd spinbutton:not(.vertical) button:dir(rtl):first-child {
  border-radius: @QUARTZ_BORDER_RADIUS@ 0 0 @QUARTZ_BORDER_RADIUS@;
}

spinbutton.vertical button.up,
colorswatch#add-color-button {
  border-radius: @QUARTZ_BORDER_RADIUS@ @QUARTZ_BORDER_RADIUS@ 0 0;
}

spinbutton.vertical button.down,
.inline-toolbar,
.app-notification,
.app-notification.frame {
  border-radius: 0 0 @QUARTZ_BORDER_RADIUS@ @QUARTZ_BORDER_RADIUS@;
}

/* A discrete meter is one joined strip, not a row of tiny pills. Keep every
 * internal segment square and round only the two ends of the complete bar. */
levelbar.horizontal.discrete trough > block:first-child {
  border-radius: @QUARTZ_BORDER_RADIUS@ 0 0 @QUARTZ_BORDER_RADIUS@;
}

levelbar.horizontal.discrete trough > block:last-child {
  border-radius: 0 @QUARTZ_BORDER_RADIUS@ @QUARTZ_BORDER_RADIUS@ 0;
}

levelbar.vertical.discrete trough > block:first-child {
  border-radius: @QUARTZ_BORDER_RADIUS@ @QUARTZ_BORDER_RADIUS@ 0 0;
}

levelbar.vertical.discrete trough > block:last-child {
  border-radius: 0 0 @QUARTZ_BORDER_RADIUS@ @QUARTZ_BORDER_RADIUS@;
}

colorswatch#add-color-button:only-child {
  border-radius: @QUARTZ_BORDER_RADIUS@;
}

colorswatch.top,
colorswatch.top overlay {
  border-top-left-radius: @QUARTZ_BORDER_RADIUS@;
  border-top-right-radius: @QUARTZ_BORDER_RADIUS@;
}

colorswatch.bottom,
colorswatch.bottom overlay {
  border-bottom-left-radius: @QUARTZ_BORDER_RADIUS@;
  border-bottom-right-radius: @QUARTZ_BORDER_RADIUS@;
}

colorswatch.left,
colorswatch:first-child:not(.top),
colorswatch.left overlay,
colorswatch:first-child:not(.top) overlay {
  border-top-left-radius: @QUARTZ_BORDER_RADIUS@;
  border-bottom-left-radius: @QUARTZ_BORDER_RADIUS@;
}

colorswatch.right,
colorswatch:last-child:not(.bottom),
colorswatch.right overlay,
colorswatch:last-child:not(.bottom) overlay {
  border-top-right-radius: @QUARTZ_BORDER_RADIUS@;
  border-bottom-right-radius: @QUARTZ_BORDER_RADIUS@;
}

menu > arrow.top,
.menu > arrow.top,
.context-menu > arrow.top {
  border-top-left-radius: @QUARTZ_BORDER_RADIUS@;
  border-top-right-radius: @QUARTZ_BORDER_RADIUS@;
}

menu > arrow.bottom,
.menu > arrow.bottom,
.context-menu > arrow.bottom {
  border-bottom-left-radius: @QUARTZ_BORDER_RADIUS@;
  border-bottom-right-radius: @QUARTZ_BORDER_RADIUS@;
}

/* Application providers may color menu labels directly. Restore contextual
 * inheritance once; the menuitem itself owns normal, selected, and disabled
 * colors, regardless of whether a GtkBox is present. */
menubar > menuitem label,
menu menuitem label,
.menu menuitem label,
.context-menu menuitem label,
popover menuitem label {
  color: inherit;
}

menu menuitem:disabled,
.menu menuitem:disabled,
.context-menu menuitem:disabled,
popover menuitem:disabled {
  color: @quartz_disabled;
  background-color: transparent;
  background-image: none;
  opacity: 1;
}

/* Ubuntu MATE shell -------------------------------------------------------
 * MATE's panel is GTK 3, while out-of-process applets inherit the same theme
 * through their GtkSocket.  Keep the color owner on every side of that
 * boundary so status items never fall back to Yaru's translucent surface. */
PanelToplevel,
PanelToplevel.background {
  color: @quartz_ink;
  background-color: @quartz_paper;
  background-image: none;
}

.mate-panel-menu-bar,
.gnome-panel-menu-bar,
.mate-panel-applet,
MatePanelAppletFrameDBus,
PanelWidget {
  color: @quartz_ink;
  background-color: @quartz_paper;
  background-image: none;
}

PanelToplevel > grid,
PanelToplevel PanelFrame,
PanelToplevel PanelWidget,
PanelToplevel MatePanelAppletFrameDBus,
PanelToplevel.horizontal PanelApplet {
  background-color: @quartz_paper;
  background-image: url("assets/panel-bar.xpm");
  background-position: left top;
  background-repeat: repeat-x;
}

PanelToplevel MatePanelAppletFrameDBus,
PanelToplevel.horizontal PanelApplet {
  border-top: 1px solid @quartz_ink;
  border-bottom: 1px solid @quartz_ink;
}

/* In-process applets are real PanelApplet children rather than GtkPlug
 * windows. An expanding child can cover nearly the complete PanelWidget,
 * so it must carry the same two rule rows as the surrounding panel. */
PanelToplevel.horizontal PanelApplet {
  min-height: 0;
  padding: 0;
}

/* MATE paints the drag-handle rectangle after the frame's CSS border.  Let
 * the exact parent panel bitmap show through that custom paint layer so the
 * handle cannot punch isolated light pixels into either one-pixel rule. */
PanelToplevel MatePanelAppletFrameDBus.mate-custom-panel-background {
  color: transparent;
  background-color: transparent;
  background-image: none;
  border-color: transparent;
  box-shadow: none;
}

PanelToplevel {
  border: 0;
  min-height: 0;
  padding: 0;
}

PanelToplevel button,
.mate-panel-menu-bar button,
.mate-panel-applet button,
#tasklist-button {
  color: @quartz_ink;
  background-color: @quartz_menubar;
  background-image: none;
  border-top: 1px solid @quartz_ink;
  border-right: 0;
  border-bottom: 1px solid @quartz_ink;
  border-left: 0;
  min-height: 0;
  min-width: 0;
  margin: 0;
  padding: 0 6px;
}

/* A panel menu launcher is a direct, flat toggle inside its PanelApplet.
 * This structural selector does not catch nested task-list buttons or
 * ordinary status-applet controls. */
.mate-panel-menu-bar PanelApplet > button.flat.toggle,
.gnome-panel-menu-bar PanelApplet > button.flat.toggle {
  border-radius: 0;
}

/* Bottom-panel buttons are flush rectangular segments. The host panel keeps
 * its placement class, while its external Show Desktop and window-list
 * applets expose stable shared component IDs across the GtkSocket boundary. */
PanelToplevel.bottom button,
#showdesktop-button,
#tasklist-button {
  border-radius: 0;
}

/* Let the explicit shared panel background own every normal in-process
 * menubar pixel so later palette changes cannot leave a stale-color strip. */
PanelToplevel menubar,
PanelToplevel menubar > menuitem {
  color: @quartz_ink;
  background-color: transparent;
  background-image: none;
}

PanelToplevel menubar,
.mate-panel-menu-bar,
.gnome-panel-menu-bar {
  border: 0;
  background-color: @quartz_menubar;
  background-image: url("assets/panel-bar.xpm");
  background-position: left top;
  background-repeat: repeat-x;
  min-height: 0;
  padding: 0;
}

/* An expanding in-process menubar can cover the complete PanelWidget. Keep
 * the panel's two one-pixel rules on that generic shared component too. */
PanelToplevel menubar {
  border-top: 1px solid @quartz_ink;
  border-bottom: 1px solid @quartz_ink;
}

/* GtkPlug panel windows do not consistently receive MATE's transient custom-
 * background class after a layout reset. Match their stable shared panel
 * classes so every plug preserves the bitmap's two rule rows. */
window.background.horizontal.mate-panel-menu-bar.gnome-panel-menu-bar {
  color: @quartz_ink;
  background-color: @quartz_menubar;
  background-image: url("assets/panel-bar.xpm");
  background-position: left top;
  background-repeat: repeat-x;
  border-top: 1px solid @quartz_ink;
  border-bottom: 1px solid @quartz_ink;
  padding: 0;
}

/* Out-of-process panel applets are full-height GtkPlug windows. Keep their
 * custom controls inside the two bitmap border rows so those rows remain
 * continuous across menu, task-list, pager, and status applets. */
PanelToplevel menubar > menuitem,
.mate-panel-menu-bar > menuitem,
.gnome-panel-menu-bar > menuitem {
  border-color: transparent;
  min-height: 0;
  min-width: 0;
  padding: 0 6px;
}

PanelToplevel label,
PanelToplevel image,
.mate-panel-menu-bar label,
.mate-panel-menu-bar image,
.mate-panel-applet label,
.mate-panel-applet image,
#tasklist-button label,
#tasklist-button image {
  color: inherit;
  opacity: 1;
}

PanelToplevel button:hover,
PanelToplevel button:active,
PanelToplevel button:checked,
PanelToplevel menubar > menuitem:hover,
PanelToplevel menubar > menuitem:active,
PanelToplevel menubar > menuitem:selected,
PanelToplevel menubar > menuitem:checked,
.mate-panel-menu-bar button:hover,
.mate-panel-menu-bar button:active,
.mate-panel-menu-bar button:checked,
.mate-panel-menu-bar > menuitem:hover,
.mate-panel-menu-bar > menuitem:active {
  color: @quartz_paper;
  background-color: @quartz_ink;
  background-image: none;
  -gtk-icon-palette: success @quartz_paper, warning @quartz_paper, error @quartz_paper;
}

/* Wnck exposes the active window through the native :checked state. */
#tasklist-button:hover,
#tasklist-button:active {
  color: @quartz_ink;
  background-color: @quartz_menubar;
}

#tasklist-button:checked,
#tasklist-button:checked:hover,
#tasklist-button:checked:active {
  color: @quartz_paper;
  background-color: @quartz_ink;
  background-image: none;
  opacity: 1;
  -gtk-icon-palette: success @quartz_paper, warning @quartz_paper, error @quartz_paper;
}

/* Keep panel images at their native scale without soft icon shadows. */
PanelToplevel button image {
  -gtk-icon-transform: scale(1);
  -gtk-icon-shadow: none;
}

PanelToplevel menubar > menuitem:disabled {
  color: @quartz_disabled;
  background-color: transparent;
  opacity: 1;
}

/* System 7 close/zoom highlight: native pixels, shared by window controls.
 * Keep the hit target stable; dragging outside cancels the pressed artwork. */
button.titlebutton.close:active:hover:not(:disabled),
button.titlebutton.maximize:active:hover:not(:disabled),
button.titlebutton.minimize:active:hover:not(:disabled) {
  background-color: @quartz_titlebar;
  background-image: url("assets/titlebutton-pressed-system7-gtk.xpm");
  background-repeat: no-repeat;
  background-position: center;
  background-size: 12px 12px;
  border-color: transparent;
  border-radius: 0;
  box-shadow: none;
  transition: none;
}

button.titlebutton.close:active:hover:not(:disabled) image,
button.titlebutton.maximize:active:hover:not(:disabled) image,
button.titlebutton.minimize:active:hover:not(:disabled) image {
  opacity: 0;
}

/* Pointer-down must not shift the decoration underneath the sprite. */
headerbar button.titlebutton.close:active,
headerbar button.titlebutton.maximize:active,
headerbar button.titlebutton.minimize:active {
  margin: 2px 1px 3px;
}
